# User-specific stuff:
.idea/*

## File-based project format:
*.iws

# IntelliJ
/out/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# logs
*.log*

# databases
*.db

# configs
*.cfg
*.json

# generators
*.bat

# locks
locks/*

# venv
/venv/
.claude/worktrees/

# Claude Code: per-machine settings
.claude/settings.local.json

# ansible-lint: local collections and roles cache
/.ansible/

# dev
/.venv/
/uv.lock
.mypy_cache/
.ruff_cache/
.pytest_cache/
/dist/
*.egg-info/
!tests/fixtures/**/*.json
